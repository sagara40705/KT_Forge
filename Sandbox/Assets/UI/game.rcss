body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans CJK JP"; font-size: 20dp; color: #ffffff; }
div { display: block; }
body.hud { pointer-events: none; }
#hud-panel { position: absolute; left: 24dp; top: 24dp; width: 320dp; height: 110dp; background-color: #172035ee; pointer-events: none; }
#portrait { position: absolute; left: 14dp; top: 25dp; width: 48dp; height: 48dp; }
#player-name { position: absolute; left: 76dp; top: 8dp; }
#hp-track { position: absolute; left: 76dp; top: 45dp; width: 224dp; height: 18dp; background-color: #343c52; overflow: hidden; }
#hp-fill { width: 100%; height: 100%; background-color: #4cd58c; }
#hp-label { position: absolute; left: 76dp; top: 69dp; font-size: 16dp; }
button { display: block; width: 240dp; height: 42dp; padding-top: 10dp; text-align: center; background-color: #344766; color: #ffffff; border-width: 0; }
button:hover { background-color: #526d94; }
button:focus { background-color: #526d94; }
button:active { background-color: #26354c; }
#pause-button { position: absolute; right: 24dp; top: 24dp; width: 130dp; pointer-events: auto; }
body.pause { background-color: #000000aa; }
#pause-panel { position: absolute; left: 50%; top: 50%; width: 360dp; height: 280dp; margin-left: -180dp; margin-top: -140dp; background-color: #172035; }
#pause-title { margin-top: 20dp; font-size: 28dp; text-align: center; }
#pause-description { margin-top: 12dp; margin-bottom: 16dp; text-align: center; font-size: 18dp; }
#pause-panel button { margin-left: 60dp; margin-top: 12dp; }
